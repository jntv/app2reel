{
  "name": "app2reel",
  "version": "0.1.0",
  "private": true,
  "description": "Turn your app into a narrated product demo and launch film, rendered locally with Codex",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@11.25.0",
  "repository": { "type": "git", "url": "git+https://github.com/jntv/app2reel.git" },
  "homepage": "https://github.com/jntv/app2reel#readme",
  "bugs": { "url": "https://github.com/jntv/app2reel/issues" },
  "keywords": ["product-demo", "video-generation", "browser-automation", "playwright", "ffmpeg", "codex", "local-first"],
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "setup": "playwright install chromium",
    "doctor": "node scripts/doctor.mjs",
    "stats": "node scripts/github-stats.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
