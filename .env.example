# Optional. Capture finds codex in PATH, or in the macOS ChatGPT app bundle.
# CODEX_BIN=/absolute/path/to/codex
PORT=4310
# DATA_DIR=/absolute/path/for/local-projects
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# Python 3.12 or 3.13 for one-time natural voice setup.
# CAPTURE_PYTHON=/absolute/path/to/python3.12
# Use the same voice directory for setup and the running server.
# CAPTURE_VOICE_DIR=/absolute/path/to/voice-runtime
